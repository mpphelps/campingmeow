generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String
  lastName  String?
  /// Set when an admin bans the account. A timestamp rather than a flag so
  /// we know when it happened, and null rather than a row deletion so their
  /// watches and history survive an unban.
  bannedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  watches   Watch[]
  preference UserPreference?
}

// Per-user settings. A separate table rather than columns on User so this can
// grow without touching the Auth0-synced identity fields.
model UserPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When false the notifier skips this user. Their watches keep running, so
  /// the openings are still there to look at in-app — email is just the
  /// delivery channel, not the subscription itself.
  emailNotifications Boolean @default(true)

  /// Lets someone change this setting from an email without logging in.
  ///
  /// Deliberately a stored random value, not a signature: it must never expire
  /// (an old email whose unsubscribe link is dead gets reported as spam
  /// instead), it must be revocable by regenerating it, and it must survive a
  /// SESSION_SECRET rotation. It is a bearer token, so it grants exactly one
  /// power — toggling this flag — and nothing else.
  unsubscribeToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A "place" in ReserveCalifornia terms: a state park containing bookable facilities.
// rcPlaceId is RC's identifier; our own id stays stable even if RC renumbers.
model Park {
  id              String     @id @default(cuid())
  rcPlaceId       Int        @unique
  name            String
  city            String?
  latitude        Float?
  longitude       Float?
  allowWebBooking Boolean    @default(true)
  // false = disappeared from the RC catalog; kept for watch/history integrity
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  facilities      Facility[]
}

// A bookable campground within a park. No lat/long in the RC catalog —
// distance features use the parent park's coordinates.
model Facility {
  id              String   @id @default(cuid())
  rcFacilityId    Int      @unique
  name            String
  // RC FacilityType code (e.g. 2 = campground); kept raw for filtering later
  facilityType    Int?
  allowWebBooking Boolean  @default(true)
  active          Boolean  @default(true)
  parkId          String
  park            Park     @relation(fields: [parkId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // Null = never scanned. Drives "we haven't checked this yet" vs "nothing open".
  lastScannedAt   DateTime?
  // What the last scan found. Only `bookable` campgrounds are scanned and
  // offered in the watch picker — a watch on the others could never fire,
  // because nothing is reservable and so no cancellation can happen.
  status          FacilityStatus @default(bookable)
  // Web-bookable units seen on the last scan. Kept for admin visibility: the
  // status says what a campground is, this says how big it is.
  bookableSites   Int            @default(0)
  // ReserveCalifornia UnitCategoryIds seen on the last scan, deduplicated.
  // A campground is usually one category, but "Campground & Cabins" style
  // sites are genuinely mixed, so this is a set. Raw RC ids: the id->label
  // mapping lives in app/lib/site-types.ts, so a new category RC invents shows
  // up as an unknown id rather than silently vanishing.
  siteCategories  Int[]
  // Longest vehicle any site here takes, 0 when none do. NOT a site type — a
  // plain tent-image campsite routinely accepts a 35ft RV — so this is for a
  // future "will my trailer fit" filter, never for the type icons.
  maxVehicleLength Int           @default(0)
  watches         WatchFacility[]
  slots           AvailabilitySlot[]
  events          AvailabilityEvent[]

  @@index([parkId])
  // The scanner picks work by "most overdue first", so it reads this ordering
  // on every iteration. Nulls (never scanned) sort first and get scanned first.
  @@index([active, lastScannedAt])
}

// Current known availability: one row per campsite per night, upserted on
// every scan. Past dates are kept for future trending.
model AvailabilitySlot {
  id         String   @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  // ReserveCalifornia unit (campsite) id and its display name.
  unitId     Int
  unitName   String
  date       DateTime @db.Date
  isFree     Boolean
  updatedAt  DateTime @updatedAt

  @@unique([facilityId, unitId, date])
  @@index([facilityId, date, isFree])
  // The prune deletes by date alone, and both indexes above lead with
  // facilityId, so without this it is a full scan of the whole table twice a
  // cycle — on roughly half a million rows.
  @@index([date])
}

// A user's subscription: "tell me when any of these campgrounds has an
// opening matching this date pattern."
model Watch {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  // Check-in days of week, 0=Sun .. 6=Sat. Non-empty; enforced in the service.
  checkinDays Int[]
  // Consecutive nights that must all be free (1-7; enforced in the service).
  nights      Int
  // No date bounds by design: a watch always covers the full rolling booking
  // window. Bounded watches meant an expiry concept (and an expired watch that
  // silently kept its campgrounds on the hourly scan tier and blocked the
  // per-user limit) for no real gain — the scanner scans the whole window
  // regardless of what dates any one watch cares about.
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  facilities  WatchFacility[]

  @@index([userId])
}

// Join table: the campgrounds a watch covers (one pattern, many facilities).
model WatchFacility {
  watchId    String
  watch      Watch    @relation(fields: [watchId], references: [id], onDelete: Cascade)
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])

  @@id([watchId, facilityId])
  @@index([facilityId])
}

// What *changed*, as opposed to what *is*. AvailabilitySlot holds current state
// and is overwritten every scan, so the moment a night flips is only observable
// during that scan — overwrite the row and the information is gone for good.
// This is the append-only record of those flips, and the only thing that can
// answer "did something just open?".
model AvailabilityEvent {
  id         String                @id @default(cuid())
  facilityId String
  facility   Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  unitId     Int
  unitName   String
  // The night that changed availability.
  date       DateTime              @db.Date
  type       AvailabilityEventType
  detectedAt DateTime              @default(now())
  // Null until the notifier has acted on it. Makes this a durable outbox: if
  // email is down, events simply stay unnotified and go out on the next pass.
  notifiedAt DateTime?

  @@index([facilityId, detectedAt])
  // The notifier's query: unnotified opens, oldest first.
  @@index([type, notifiedAt])
}

enum FacilityStatus {
  /// Has web-bookable sites. The only status the scanner works on.
  bookable
  /// ReserveCalifornia returns no units at all — closed, seasonal, or retired.
  no_inventory
  /// Units exist but none allow web booking: first-come, first-served.
  first_come_first_served
}

enum AvailabilityEventType {
  opened
  closed
}

// One row per batch of notification emails, for the emails-per-day metric.
model EmailLog {
  id       String   @id @default(cuid())
  sentAt   DateTime @default(now())
  // How many emails went out in this batch.
  quantity Int
  // { userId: [eventId, ...] } — who was told about what.
  metadata Json

  @@index([sentAt])
}
